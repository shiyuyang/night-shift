# Imported inside api.liveinteractivegame.com; each game owns only its own prefix.
redir /games/night-shift /games/night-shift/ 308
handle_path /games/night-shift/* {
    root * /srv/games/night-shift/current
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Cache-Control "public, max-age=3600"
    @entry path / /index.html
    header @entry Cache-Control "no-cache"
    @code path_regexp code ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css)$
    header @code Cache-Control "public, max-age=31536000, immutable"
    file_server
}
